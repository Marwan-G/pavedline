// Pavedline — architecture of the factory itself. Source of truth for ARCHITECTURE.svg; explained in docs/architecture.md.
// Validate + render: python3 scripts/dot_check.py   Check: python3 scripts/dot_check.py --check
digraph architecture {
  graph [rankdir=TB, fontname="Helvetica", bgcolor="white", pad=0.4, nodesep=0.45, ranksep=0.6, newrank=true,
         label="Pavedline — architecture of the plugin marketplace and its CI",
         labelloc=t, fontsize=20, fontcolor="#0F172A"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155",
         fillcolor="#FFFFFF", penwidth=1.2, width=2.4, height=0.8];
  edge  [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7, penwidth=1.2, fontcolor="#B45309"];

  market [label="Marketplace\n.claude-plugin/marketplace.json", fillcolor="#FFFBEB", color="#F59E0B"];
  deps   [label="Dependencies\nsuperpowers · mattpocock-skills\nproduct-management · figma\noptional: ui-ux-pro-max · marketing", shape=note, fillcolor="#F1F5F9", color="#64748B"];

  subgraph cluster_plugin {
    label="PLUGIN — plugins/pavedline"; style="rounded,filled"; fillcolor="#EFF6FF"; color="#93C5FD"; fontcolor="#1E3A8A"; fontsize=13;
    manifest  [label="plugin.json\nname · version · dependencies"];
    skills    [label="Skills (32)\nsteps 0–12 · integration wave · grow\ndoctor · state\nlocal-cluster · gitops …"];
    agents    [label="Agents (9)\nresearcher · architect · reviewer · designer\ndesign-verifier · builder · adversary · deployer · growth\nmodel generated from config/models.yaml"];
    hooks     [label="Hooks (11)\nsecrets · cluster context · git · STATE.md cap\nwarn: CLAUDE.md size · PR gates line · diagram drift\nsession start · compaction notes · records commit reminder\nbuilder report check"];
    mcp       [label="MCP server\nPlaywright (.mcp.json)"];
    scripts   [label="Scripts\ndoctor · start_project\napply_stack · plan_graph\nlocal cluster: up · verify · down"];
    templates [label="Templates\nCLAUDE.md · PRODUCT.md · STATE.md\nWAITING.md · decisions · docs\ninfra · profiles (BYO, OCI) · alerts · CI"];
    stack     [label="Stack pack · nextjs-fastapi\nfiles/ → product at step 6\nexample/ → starter check only"];
  }

  subgraph cluster_repo {
    label="REPO — scripts and tests"; style="rounded,filled"; fillcolor="#F5F3FF"; color="#C4B5FD"; fontcolor="#4C1D95"; fontsize=13;
    sanitize [label="sanitize_scan.py\ndeny-list scan of every tracked file"];
    dotcheck [label="dot_check.py\nvalidate · render · hash check"];
    dotdrift [label="dot_drift.py\ncode changed, diagram not?"];
    tests    [label="tests/\nunittest, stdlib only"];
    prcheck  [label="pr_checks.py · lint_skills.py\ngates line · skill format"];
  }

  subgraph cluster_ci {
    label="CI — GitHub Actions"; style="rounded,filled"; fillcolor="#ECFDF5"; color="#6EE7B7"; fontcolor="#064E3B"; fontsize=13;
    ci [label="8 required checks + CodeQL; starter runs on every PR\nunit · lint · sanitize · gitleaks · diagrams\nplugin-validate · local-cluster · pr-body"];
  }

  cockpit [label="Second plugin: pavedline-cockpit\n(optional status pane)", fillcolor="#F8FAFC", color="#94A3B8", style="rounded,filled,dashed"];
  user [label="Your project\n(repository you build in)", fillcolor="#FEF2F2", color="#FCA5A5"];

  market -> manifest [label=" lists "];
  manifest -> deps [label=" requires ", style=dashed];
  manifest -> skills; manifest -> agents; manifest -> hooks; manifest -> mcp; manifest -> templates; manifest -> stack; manifest -> scripts;
  templates -> user [label=" start copies ", color="#16A34A", fontcolor="#16A34A"];
  stack -> user [label=" step 6 copies ", color="#16A34A", fontcolor="#16A34A"];
  hooks -> user [label=" guard every tool call ", color="#B91C1C", fontcolor="#B91C1C"];
  scripts -> user [label=" local cluster ", color="#1D4ED8", fontcolor="#1D4ED8"];
  market -> cockpit [label=" lists ", style=dashed];
  skills -> agents [label=" dispatch ", style=dashed];

  sanitize -> ci; dotcheck -> ci; dotdrift -> ci; tests -> ci; prcheck -> ci;
  ci -> market [label=" gates every change ", style=dashed, color="#059669", fontcolor="#059669", constraint=false];
}
