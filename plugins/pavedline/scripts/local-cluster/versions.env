# Pinned versions for the local cluster. verified 2026-11-07
# Node image: kind v0.33.0 release notes (default image), pinned by digest.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Helm charts as OCI artifacts on ghcr.io (published by each project), pinned by version and digest. verified 2026-11-08
# OCI avoids GitHub release downloads, which returned 504 for an hour on 2026-11-08 while ghcr.io served in ~1s.
ARGOCD_CHART=oci://ghcr.io/argoproj/argo-helm/argo-cd
ARGOCD_CHART_VERSION=10.15.0
ARGOCD_CHART_DIGEST=sha256:9c827f27e4d587b191b1e9becadc472bbaeb0ca0a18608425ba0ee4915d4ee48
CNPG_CHART=oci://ghcr.io/cloudnative-pg/charts/cloudnative-pg
CNPG_CHART_VERSION=0.29.1
CNPG_CHART_DIGEST=sha256:3245fa051bb21d0dd9246272f57a2760b4234817a164a3167d2a1e7fb9f63fd9
# Minimum helm CLI. helm v4.2.1 waits the full --timeout on every hook deletion, so the Argo CD install (4 hooks)
# took 40 minutes instead of under one; fixed in v4.2.2: https://github.com/helm/helm/issues/32214 (CI runs v4.3.1).
HELM_MIN_VERSION=4.2.2
# Host port of the local image registry (container kind-registry).
REGISTRY_PORT=5001
# --- Gateway API and the local git server. verified 2026-11-09 (sources and dates: skills/gitops/references/sources.md)
# Gateway API standard CRDs v1.6.3 (released 2026-10-06; v1.7.0 of 2026-10-29 is under two weeks old). Applied by up.sh
# BEFORE Envoy Gateway; the file's sha256 is checked. The Envoy Gateway chart bundles older Gateway API CRDs (v1.6.1,
# experimental channel) and Helm 4 conflicts with existing ones, so up.sh installs the chart with crds.enabled=false and
# applies only the chart's Envoy CRDs itself: kubectl owns every CRD.
GATEWAY_API_VERSION=v1.6.3
GATEWAY_CRDS_SHA256=356c2b8e286a964dc20995435659ad1095386329974793af10bbfe3eff977fe5
# Renovate tracks every pin here and none is automerged. Note: a Renovate bump fails up.sh's checksum until GATEWAY_CRDS_SHA256 is updated by hand — intended (the digest is the check).
# Envoy Gateway (Apache-2.0), chart on Docker Hub OCI, by version and digest. v1.9.2 (2026-09-28) is the newest line
# whose matrix entry is compatible with Gateway API v1.6.x (v1.9 and v1.10 compile in v1.6.1) and that is at least two
# weeks old (v1.10.0 is 2026-11-06). https://gateway.envoyproxy.io/news/releases/matrix/
ENVOY_GATEWAY_CHART=oci://docker.io/envoyproxy/gateway-helm
ENVOY_GATEWAY_CHART_VERSION=v1.9.2
ENVOY_GATEWAY_CHART_DIGEST=sha256:be034275b55deeddd6b7bc1f4da6eeb02b8efc418a4a29e2b1977851b24b1e63
# Base image of the local git server (container kind-git) and of the tiny echo backend used by verify.sh.
# alpine 3.24.3, pushed 2026-10-23 (17 days old); digest is the multi-arch index.
GIT_SERVER_BASE_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
ECHO_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
