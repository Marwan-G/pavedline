# Copy to .env.local (gitignored; never commit it) and fill in your identity provider's TEST values. Read only by
# scripts/local_secrets.sh, which puts them in the local cluster's api-auth Secret. Leave a key empty (or the file
# absent) and the API runs locally with APP_ENV=development and no token verification keys: every /v1 route answers 401.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_TENANT_CLAIM=
