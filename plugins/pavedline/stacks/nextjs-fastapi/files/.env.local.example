# Copy to .env.local (gitignored; never commit it) and fill in your identity provider's TEST values. Read only by
# scripts/local_secrets.sh, which puts them in the local cluster's api-auth Secret. Leave a key empty (or the file
# absent) and the API runs locally with APP_ENV=development and no token verification keys: every /v1 route answers 401.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_TENANT_CLAIM=

# Signed webhooks (the API's /webhooks/clerk and /webhooks/stripe exist only when the secret is set). Test-mode values only.
# Clerk: dashboard (development instance) > Configure > Webhooks > your endpoint > Signing Secret (starts whsec_).
# Stripe: the `whsec_...` that `stripe listen --forward-to` prints (sandbox), or the sandbox endpoint's signing secret.
WEBHOOK_CLERK_SECRET=
WEBHOOK_STRIPE_SECRET=

# Provider TEST secret keys for the integration wave (the integration wave's slices read them). Test or
# sandbox keys only, never live ones; leave them commented until then. Copied into the local api-provider-keys Secret
# only when non-empty; no chart mounts it by default, the product's own slices do.
# CLERK_SECRET_KEY=
# STRIPE_SECRET_KEY=

# Local fakes (scripts/local-cluster/up.sh <project> --fakes): point the product's email and SMS settings at them.
# In the cluster:  SMTP_HOST=mailpit.fakes.svc.cluster.local  SMTP_PORT=1025   SMS_BASE_URL=http://sms-sink.fakes.svc.cluster.local
# From this machine (through the Gateway): http://mail.localtest.me:8080 (Mailpit inbox + API), http://sms.localtest.me:8080/messages
