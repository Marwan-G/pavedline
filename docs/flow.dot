// Pavedline — the flow, idea to production. Source of truth for docs/flow.svg.
// Validate: dot -Tcanon docs/flow.dot -o /dev/null   Render: dot -Tsvg docs/flow.dot -o docs/flow.svg
digraph pavedline {
  graph [rankdir=TB, fontname="Helvetica", bgcolor="white", pad=0.4, nodesep=0.45, ranksep=0.55, newrank=true,
         label="Pavedline — the GitOps software factory for Claude Code\nship a multi-tenant SaaS to production, not a demo · website + blog · web app · mobile app",
         labelloc=t, fontsize=20, fontcolor="#0F172A"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155",
         fillcolor="#FFFFFF", penwidth=1.2, width=2.6, height=1.0];
  edge  [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7, penwidth=1.2, fontcolor="#B45309"];

  subgraph cluster_discover {
    label="DISCOVER"; style="rounded,filled"; fillcolor="#EFF6FF"; color="#93C5FD"; fontcolor="#1E3A8A"; fontsize=13;
    step0  [label="0 · Start\nwhat are you building? · multi-tenant?\ncompliance in mind? · solo/team · surfaces\nDB in Kubernetes or managed? · local runtime"];
    step1  [label="1 · Market + SEO research\nyour similar sites → competitors\npricing · positioning · topics\n→ BRIEF · SEO-STRATEGY"];
    step2  [label="2 · Grill\nrelentless interview\n→ decisions · GLOSSARY"];
    step3  [label="3 · Spec\nusers · jobs · features per surface\nacceptance tests\n→ SPEC.md"];
  }
  subgraph cluster_design {
    label="DESIGN"; style="rounded,filled"; fillcolor="#F5F3FF"; color="#C4B5FD"; fontcolor="#4C1D95"; fontsize=13;
    step4  [label="4 · System design (must-ask)\nbackend · Clerk · security · tenancy\njobs · notifications · payments\nregions · mesh · SEO · lead times"];
    step5  [label="5 · Data + API\ndomain · erd.dot · schema\nRLS forced · migrations\nOpenAPI first"];
    step6  [label="6 · Architecture\nARCHITECTURE.dot · threats\nHelm chart · environments\nstack templates applied"];
    step7  [label="7 · Figma (required)\ntokens · components\nsite · blog · web app · mobile\nevery screen · every state"];
  }
  subgraph cluster_deliver {
    label="DELIVER — each wave, on LOCAL Kubernetes"; style="rounded,filled"; fillcolor="#ECFDF5"; color="#6EE7B7"; fontcolor="#064E3B"; fontsize=13;
    step8  [label="8 · Plan\nwave → slices\n→ plan.md + plan.dot"];
    step9  [label="9 · Build (per slice)\nTDD → review → security\n→ adversarial → verify\n→ squash-merge PR"];
    step10 [label="10 · Deploy to local\nGitOps → ArgoCD in kind\nmigrations first\nverify RUNNING pods"];
    step11 [label="11 · Learn\nretro → lessons\nrule fixed in ONE place", fillcolor="#FFFBEB", color="#F59E0B"];
  }
  integ [label="Integration wave\nprovider test modes · real webhooks\nTestFlight / internal track", fillcolor="#F0FDF4", color="#16A34A"];
  subgraph cluster_prod {
    label="PRODUCTION — once, at the end"; style="rounded,filled"; fillcolor="#FEF2F2"; color="#FCA5A5"; fontcolor="#7F1D1D"; fontsize=13;
    step12 [label="12 · Go to production (cloud)\n\"time for production?\" → what infra do you have?\n→ NEEDS.md (what I need from you)\nyour terraform apply → CLOUD STAGING verified\n→ PRODUCTION verified → LAUNCH checklist → you: go live"];
  }

  { rank=same; step0; step1; step2; step3; }
  { rank=same; step4; step5; step6; step7; }
  { rank=same; step8; step9; step10; step11; }

  step0 -> step1 [xlabel="you confirm "];
  step1 -> step2 [xlabel="you approve "];
  step2 -> step3;
  step3 -> step4 [xlabel="you approve "];
  step4 -> step5 [xlabel="you answer + go "];
  step5 -> step6 [xlabel="blind review +\nyou approve "];
  step6 -> step7 [xlabel="you approve "];
  step7 -> step8 [xlabel="blind check +\nyou approve visual "];
  step8 -> step9 [xlabel="you approve wave "];
  step9 -> step10 [xlabel="5 gates per slice "];
  step10 -> step11 [xlabel="verified (local) "];
  step11 -> step8 [label=" next wave", style=dashed, color="#059669", fontcolor="#059669", constraint=false];
  step11 -> integ [xlabel="feature-complete ", color="#16A34A", fontcolor="#16A34A"];
  integ -> step12 [xlabel="you say go ", color="#B91C1C", fontcolor="#B91C1C"];

  node [shape=note, style="filled", fillcolor="#F1F5F9", color="#64748B", fontsize=10, width=3.6, height=0.9];
  mem   [label="MEMORY — files only; any fresh session resumes\nCLAUDE.md ≤150 · PRODUCT · STATE.md ≤60 (hook)\nWAITING · decisions/ · GLOSSARY · handoff/"];
  git   [label="GITOPS — git is the only path to a cluster\nHelm · ArgoCD · image tags · Terraform\nrollback = revert + expand/contract migrations"];
  guard [label="ENFORCED, NOT PROSE\nCI: tests · scanners · leak test · SEO + a11y gates\nhooks: secrets · cluster context · STATE cap"];
  grow  [label="AFTER LAUNCH\nGrow loop (SEO + content) · three alerts:\nuptime · backup failed · job failed/late", fillcolor="#FFF7ED", color="#EA580C"];
  { rank=same; mem; git; guard; grow; }
  step12 -> mem [style=invis]; step12 -> git [style=invis]; step12 -> guard [style=invis]; step12 -> grow [style=invis];
}
