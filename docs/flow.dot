// Pavedline — the flow, idea to production. Source of truth for docs/flow.svg.
// Four phase bands read as a snake (left→right, then right→left, …) so every connector is short and straight.
// Colour marks the phase only (card header and band title); everything else is neutral.
// Render: python3 scripts/dot_check.py   Check: python3 scripts/dot_check.py --check
digraph pavedline {
  graph [rankdir=TB, fontname="Helvetica,Arial,sans-serif", bgcolor="white", pad="0.35,0.3", nodesep=0.32, ranksep=0.5,
         newrank=true, splines=ortho, labelloc=t, labeljust=l, fontsize=24, fontcolor="#0F172A",
         label=<<B>Pavedline</B><FONT COLOR="#64748B">  ·  idea to production, one paved path</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#64748B">Website, blog, web app and mobile app. Multi-tenant from the first question. GitOps on Kubernetes from the first deploy.</FONT><BR ALIGN="LEFT"/> >];
  node  [shape=plain, fontname="Helvetica,Arial,sans-serif", fontsize=13, fontcolor="#0F172A"];
  edge  [color="#94A3B8", penwidth=1.6, arrowsize=0.7, arrowhead=normal];

  // ── 01 DISCOVER ─────────────────────────────────────────────── left → right
  subgraph cluster_discover {
    label=<<FONT COLOR="#1D4ED8"><B>01  DISCOVER</B></FONT><FONT COLOR="#64748B">   what to build, for whom, and why</FONT>>;
    fontsize=12; labeljust=l; style="rounded,filled"; fillcolor="#F8FAFC"; color="#E2E8F0"; penwidth=1;
    s0 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#1D4ED8" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#1D4ED8"><B>STEP 00</B></FONT><BR ALIGN="LEFT"/><B>Start</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">product · tenancy · compliance</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#1D4ED8" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#1D4ED8"><B>STEP 01</B></FONT><BR ALIGN="LEFT"/><B>Market + SEO</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">competitors · pricing · keywords</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#1D4ED8" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#1D4ED8"><B>STEP 02</B></FONT><BR ALIGN="LEFT"/><B>Grill</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">every open decision answered</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#1D4ED8" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#1D4ED8"><B>STEP 03</B></FONT><BR ALIGN="LEFT"/><B>Spec</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">features · acceptance tests</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  // ── 02 DESIGN ───────────────────────────────────────────────── right → left
  subgraph cluster_design {
    label=<<FONT COLOR="#6D28D9"><B>02  DESIGN</B></FONT><FONT COLOR="#64748B">   the expensive decisions, made once</FONT>>;
    fontsize=12; labeljust=l; style="rounded,filled"; fillcolor="#F8FAFC"; color="#E2E8F0"; penwidth=1;
    s7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#6D28D9" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6D28D9"><B>STEP 07</B></FONT><BR ALIGN="LEFT"/><B>Figma</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">every screen, every state</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#6D28D9" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6D28D9"><B>STEP 06</B></FONT><BR ALIGN="LEFT"/><B>Architecture</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">diagrams · threats · Helm</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#6D28D9" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6D28D9"><B>STEP 05</B></FONT><BR ALIGN="LEFT"/><B>Data + API</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">schema · row security · OpenAPI</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#6D28D9" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6D28D9"><B>STEP 04</B></FONT><BR ALIGN="LEFT"/><B>System design</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">backend · auth · security</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  // ── 03 DELIVER ──────────────────────────────────────────────── left → right, repeated per wave
  subgraph cluster_deliver {
    label=<<FONT COLOR="#047857"><B>03  DELIVER</B></FONT><FONT COLOR="#64748B">   repeated for every wave, on Kubernetes on your machine</FONT>>;
    fontsize=12; labeljust=r; style="rounded,filled"; fillcolor="#F8FAFC"; color="#E2E8F0"; penwidth=1;
    s8  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#047857" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#047857"><B>STEP 08</B></FONT><BR ALIGN="LEFT"/><B>Plan</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">a wave of small slices</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s9  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#047857" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#047857"><B>STEP 09</B></FONT><BR ALIGN="LEFT"/><B>Build</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">tests first · five review gates</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s10 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#047857" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#047857"><B>STEP 10</B></FONT><BR ALIGN="LEFT"/><B>Deploy to local</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">Argo CD · running pods verified</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s11 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#047857" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#047857"><B>STEP 11</B></FONT><BR ALIGN="LEFT"/><B>Learn</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">retro, then the next wave</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  // ── 04 PRODUCTION ───────────────────────────────────────────── right → left, once
  subgraph cluster_prod {
    label=<<FONT COLOR="#B91C1C"><B>04  PRODUCTION</B></FONT><FONT COLOR="#64748B">   once, when everything works</FONT>>;
    fontsize=12; labeljust=l; style="rounded,filled"; fillcolor="#F8FAFC"; color="#E2E8F0"; penwidth=1;
    grow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#B91C1C" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#B91C1C"><B>AFTER LAUNCH</B></FONT><BR ALIGN="LEFT"/><B>Grow</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">SEO and content · alerts</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    live [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#B91C1C" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#B91C1C"><B>LAUNCH</B></FONT><BR ALIGN="LEFT"/><B>Go live</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">launch checklist passed</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    s12  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#B91C1C" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#B91C1C"><B>STEP 12</B></FONT><BR ALIGN="LEFT"/><B>Go to production</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">cloud staging, then production</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    integ[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#CBD5E1" BGCOLOR="white" STYLE="rounded"><TR><TD BGCOLOR="#B91C1C" ALIGN="LEFT" WIDTH="190" HEIGHT="4" CELLPADDING="0"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#B91C1C"><B>FEATURE-COMPLETE</B></FONT><BR ALIGN="LEFT"/><B>Integration wave</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#64748B">real webhooks · store test tracks</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  { rank=same; s0; s1; s2; s3; }
  { rank=same; s7; s6; s5; s4; }
  { rank=same; s8; s9; s10; s11; }
  { rank=same; grow; live; s12; integ; }

  // Keep the four columns aligned across bands.
  s0 -> s7 -> s8 -> grow [style=invis, weight=5];
  s1 -> s6 -> s9 -> live [style=invis, weight=5];
  s2 -> s5 -> s10 -> s12 [style=invis, weight=5];
  s3 -> s4 -> s11 -> integ [style=invis, weight=5];

  // The path. Right-to-left bands are written left→right (straight rows) and drawn backwards.
  // High weight keeps each band's cards in a straight row, in order.
  edge [weight=20];
  s0 -> s1; s1 -> s2; s2 -> s3;
  s5 -> s4 [dir=back]; s6 -> s5 [dir=back]; s7 -> s6 [dir=back];
  s8 -> s9; s9 -> s10; s10 -> s11;
  s12 -> integ [dir=back]; live -> s12 [dir=back]; grow -> live [dir=back];
  edge [weight=1];
  s3 -> s4; s7 -> s8; s11 -> integ;

  // Foundations, one bar under everything.
  foot [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#0F172A" STYLE="rounded"><TR>
    <TD ALIGN="LEFT" WIDTH="80"><FONT POINT-SIZE="9" COLOR="#94A3B8"><B>ALWAYS<BR ALIGN="LEFT"/>ON</B></FONT></TD>
    <TD ALIGN="LEFT" WIDTH="196"><FONT COLOR="white"><B>Memory in files</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#CBD5E1">a new session resumes from the repo</FONT><BR ALIGN="LEFT"/></TD>
    <TD ALIGN="LEFT" WIDTH="196"><FONT COLOR="white"><B>GitOps only</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#CBD5E1">git is the only path to a cluster</FONT><BR ALIGN="LEFT"/></TD>
    <TD ALIGN="LEFT" WIDTH="196"><FONT COLOR="white"><B>Enforced, not prose</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#CBD5E1">CI gates · scanners · hooks</FONT><BR ALIGN="LEFT"/></TD>
    <TD ALIGN="LEFT" WIDTH="196"><FONT COLOR="white"><B>You approve</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10.5" COLOR="#CBD5E1">each step before the next starts</FONT><BR ALIGN="LEFT"/></TD>
  </TR></TABLE>>];
  live -> foot [style=invis]; s12 -> foot [style=invis];
}
