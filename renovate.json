{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group minor and patch updates into one weekly PR",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "weekly minor and patch updates"
    },
    {
      "description": "Automerge patch updates and digest pins of GitHub Actions only",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": null,
      "automerge": true
    },
    {
      "description": "Local-cluster pins are never automerged",
      "matchFileNames": [
        "plugins/pavedline/scripts/local-cluster/versions.env",
        "scripts/gitleaks.env"
      ],
      "automerge": false
    },
    {
      "description": "NEVER automerge container images referenced from workflows (services.*.image, docker:// steps): the github-actions manager extracts them with datasource docker",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "automerge": false
    },
    {
      "description": "Never automerge the PostgreSQL images of the pack, and never move to another major (the database decision does that)",
      "matchFileNames": [
        "plugins/pavedline/stacks/**/pack.yaml"
      ],
      "matchPackageNames": [
        "/postgres/",
        "/postgresql/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Never automerge the PostgreSQL images of the pack",
      "matchFileNames": [
        "plugins/pavedline/stacks/**/pack.yaml"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "argo-cd Helm chart (OCI, version and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "ARGOCD_CHART=oci://(?<depName>\\S+)\\nARGOCD_CHART_VERSION=(?<currentValue>\\S+)\\nARGOCD_CHART_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cloudnative-pg Helm chart (OCI, version and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "CNPG_CHART=oci://(?<depName>\\S+)\\nCNPG_CHART_VERSION=(?<currentValue>\\S+)\\nCNPG_CHART_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "kind node image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "KIND_NODE_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Envoy Gateway Helm chart (OCI, version and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "ENVOY_GATEWAY_CHART=oci://(?<depName>\\S+)\\nENVOY_GATEWAY_CHART_VERSION=(?<currentValue>\\S+)\\nENVOY_GATEWAY_CHART_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "git server base image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "GIT_SERVER_BASE_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "echo backend image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "ECHO_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Gateway API standard CRDs release in versions.env (the sha256 is updated by hand)",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "GATEWAY_API_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "gitleaks scanner image (tag and digest) in scripts/gitleaks.env",
      "managerFilePatterns": [
        "/(^|/)gitleaks\\.env$/"
      ],
      "matchStrings": [
        "GITLEAKS_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cert-manager Helm chart (OCI, version and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "CERT_MANAGER_CHART=oci://(?<depName>\\S+)\\nCERT_MANAGER_CHART_VERSION=(?<currentValue>\\S+)\\nCERT_MANAGER_CHART_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Barman Cloud plugin release in versions.env (the sha256 is updated by hand)",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "BARMAN_PLUGIN_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudnative-pg/plugin-barman-cloud"
    },
    {
      "customType": "regex",
      "description": "Barman Cloud plugin image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "BARMAN_PLUGIN_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Barman Cloud plugin sidecar image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "BARMAN_SIDECAR_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "SeaweedFS image (tag and digest) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "SEAWEEDFS_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Mailpit image in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "MAILPIT_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cloudflared image in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "CLOUDFLARED_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "SMS sink base image (the python pin of the API Dockerfile; keep them equal) in versions.env",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "SMS_SINK_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "PostgreSQL images of the stack pack (CloudNativePG cluster image and the CI test image), tag and digest, in pack.yaml; a major is chosen by the product's database decision, never by an update",
      "managerFilePatterns": [
        "/(^|/)pack\\.yaml$/"
      ],
      "matchStrings": [
        "(?:cluster|test): (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
